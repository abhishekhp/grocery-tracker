# Open-weight model hosted for free by Groq (https://console.groq.com)
#   1. Sign up free (no credit card): https://console.groq.com/keys
#   2. Paste your key below
# Default model is openai/gpt-oss-20b (Apache-2.0, open-weight).
# Other free options: llama-3.3-70b-versatile, qwen/qwen3-32b, openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Resend (https://resend.com) free tier transactional email API.
# Leave blank to run in dry-run mode (emails print to the console instead of sending).
RESEND_API_KEY=
FROM_EMAIL=price-tracker@yourdomain.com
